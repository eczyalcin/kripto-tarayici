# Bu dosyayı `.env` olarak kopyalayın ve doldurun.
# Market verisi için API anahtarı GEREKMEZ; buradaki değerler bildirim ve panel
# erişimi içindir.

# --- Panel parolası ---
# Doldurulursa panel açılışta parola sorar. Paneli telefon/başka bilgisayarlardan
# (--lan) veya tünel üzerinden açacaksanız MUTLAKA doldurun.
# Boş bırakılırsa parola sorulmaz.
DASHBOARD_PASSWORD=

# --- Telegram (config.yaml içinde alerts.channels.telegram: true yapın) ---
# Bot oluşturma: Telegram'da @BotFather -> /newbot
# Chat ID öğrenme: bota mesaj atıp
#   https://api.telegram.org/bot<TOKEN>/getUpdates adresini açın
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-posta (config.yaml içinde alerts.channels.email: true yapın) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
